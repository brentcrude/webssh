<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional. Only for the locally-managed tunnel variant: if you installed the connector
  with `sudo cloudflared service install <token>` from the dashboard, this file is not
  needed - that already registers a launch daemon that starts at boot.

  Expects config.yml at ~/.cloudflared/config.yml (Intel Macs:
  /usr/local/bin/cloudflared), then:
      cp com.cloudflare.macremote.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.cloudflare.macremote.plist
  Logs: /tmp/cloudflared-macremote.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cloudflare.macremote</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>--no-autoupdate</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>/Users/knerd/.cloudflared/config.yml</string>
    <string>run</string>
    <string>mac-remote</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/cloudflared-macremote.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/cloudflared-macremote.log</string>
</dict>
</plist>
